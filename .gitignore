# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/docs/official-website/node_modules

# testing
/coverage

# next.js
/.next/
/.vinext/
/.vite/
/out/
/docs/official-website/.next
/docs/official-website/out


# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/docs/official-website/dev-log.txt  

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.container.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/
.artifacts/
.agent-lab/
.evolution-lab/
.dev.vars
/docs/official-website/next-env.d.ts

# agent tooling (not part of the shipped project)
.claude/
.omc/

# local knowledge export (debug artifact)
myapp-knowledge.json
crawl-*.json
# Architecture contracts are source files, not debug artifacts; the rule above does not apply
!docs/architecture/contracts/crawl-*.schema.json

# scratch outputs from local test runs — never commit these
.tmp-*
*.log

# ./setup leaves this for one moment between the wizard and docker compose up
.sitewake-setup-start
