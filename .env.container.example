# Docker Compose configuration for SiteWake.
#
# You normally do not edit this file: `./setup` copies it to `.env`, asks for
# your model service and public origin, generates the random secrets, and
# verifies the model before writing. Editing a copy by hand is the fallback
# for non-interactive environments; every value below is documented in place.
#
POSTGRES_USER=sitewake
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sitewake
MINIO_ROOT_USER=sitewake
MINIO_ROOT_PASSWORD=change-me-too
S3_BUCKET=sitewake-artifacts
SITEWAKE_BIND_ADDRESS=0.0.0.0
SITEWAKE_PORT=3000
# Browser-visible SiteWake origin. Replace this example with the Docker
# server's exact LAN/public origin (including scheme and non-default port).
# Capability V2 derives its browser module URL from this value. Override the
# derived value only when modules use a different browser-visible origin.
SITEWAKE_PUBLIC_ORIGIN=http://192.168.1.20:3000
CAPABILITY_V2_BROWSER_PUBLIC_URL=
# PageAgent V2 rollout controls accept off/on, sites:site-a,site-b, or percent:10.
SITEWAKE_PAGE_AGENT_RUNTIME_V2=off
SITEWAKE_PAGE_AGENT_EVIDENCE_V2=off
SITEWAKE_CAPABILITY_EXPERIENCE_OUTBOX=off
SITEWAKE_RUNNER_ENROLLMENT_TOKEN=replace-with-a-random-64-character-hex-token
SITEWAKE_LEGACY_RUNNER_PROTOCOL=false
# Server-only lease authority rollback: central (default) or legacy.
SITEWAKE_RUNNER_LEASE_AUTHORITY=central
# Runner projection exposed by the control plane: full, aggregate, or hidden.
SITEWAKE_RUNNER_VISIBILITY=full
# Used only while explicitly running the retired shared-token protocol.
SITEWAKE_RUNNER_TOKEN=
# Stable logical identities survive container replacement. Change them only
# when intentionally provisioning an additional independent runner.
SITEWAKE_AUTHORING_RUNNER_ID=authoring-primary
SITEWAKE_VALIDATION_RUNNER_ID=validation-primary
SITEWAKE_EXECUTION_RUNNER_ID=execution-primary
# Capability Center V2 uses one task-scoped Runner process per build or
# validation. Generate independent random 64-character hex values for all
# three secrets; the standard server deploy command does this automatically.
CAPABILITY_V2_RUNNER_SECRET=replace-with-a-random-64-character-hex-secret
CAPABILITY_V2_DISPATCH_TOKEN=replace-with-a-random-64-character-hex-token
CAPABILITY_V2_RUNTIME_LAUNCHER_TOKEN=replace-with-a-random-64-character-hex-token
# Set to 1 only for a local production-topology test that targets localhost or
# host.docker.internal. Keep disabled on public deployments.
CAPABILITY_V2_ALLOW_PRIVATE_ORIGIN=0
# One OpenAI-compatible provider configuration is shared by the control plane
# and every worker. OPENAI_* and the earlier SITEWAKE_*/SITEWAKE_* names stay
# readable for existing installations; new deployments use MODEL_* below.
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL=
# Optional per-role overrides. Unset roles use MODEL above.
MODEL_EXECUTION=
MODEL_SEMANTIC=
SITEWAKE_CODEX_AUTHORING_TIMEOUT_MS=600000
SITEWAKE_CODEX_AUTHORING_MAX_TOOL_CALLS=48
# Optional Cloudflare Tunnel edge. These are not required for LAN deployment.
CLOUDFLARE_TUNNEL_TOKEN=
SITEWAKE_PUBLIC_HOSTNAME=
SITEWAKE_LAB_HOSTNAME=
# Optional master key for managing/recovering the site access password (访问密码)
# from /access. Leave empty to authorize changes with the current access password.
ACCESS_ADMIN_KEY=
