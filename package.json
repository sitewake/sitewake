{
  "name": "sitewake",
  "version": "1.0.3",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "sdk:build": "node scripts/build-sitewake-sdk.mjs",
    "data:clear:local": "node scripts/clear-local-business-data.mjs",
    "data:clear:capability-v2:local": "node scripts/clear-capability-v2-local-data.mjs",
    "setup": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/setup.mjs",
    "dev": "node --env-file-if-exists=.env.local scripts/dev-local.mjs",
    "dev:server": "node --env-file-if-exists=.env.local scripts/dev-local.mjs",
    "dev:control-plane": "npm run sdk:build && node scripts/run-vinext.mjs dev --hostname 0.0.0.0 --port 3000 --strictPort",
    "build": "npm run sdk:build && node scripts/run-vinext.mjs build",
    "start": "node scripts/run-vinext.mjs start",
    "typecheck": "tsc --noEmit",
    "typecheck:production": "tsc --noEmit --project tsconfig.production.json",
    "test:contracts": "node --test tests/knowledge-search.test.mjs tests/capability-center-four-table.test.mjs",
    "test:runtime-security": "node --test tests/agent-run-v3.test.mjs tests/crawl-authorization.test.mjs tests/runtime-model-budget.test.mjs tests/runtime-guard-p1.test.mjs && node --test --test-name-pattern='^public runtime model and evidence ingestion require' tests/site-agent-v2.test.mjs",
    "test:deploy-contract": "node --test tests/deployment-security.test.mjs && node --experimental-strip-types --test tests/container-runtime.test.mjs",
    "test:quickstart": "node --import tsx --test tests/cli-copy.test.mjs tests/model-check-core.test.mjs tests/model-check-fixture.test.mjs tests/provider-policy-strippable.test.mjs tests/setup-wizard.test.mjs tests/system-model-settings.test.mjs tests/setup-entrypoint.test.mjs tests/preflight-locale.test.mjs tests/readme-quickstart.test.mjs",
    "audit:runtime": "node scripts/audit-runtime.mjs",
    "verify:release": "npm run audit:runtime && npm run typecheck:production && npm run build && npm run test:contracts && npm run test:runtime-security && npm run test:deploy-contract && npm run test:quickstart && npm run test:capability-recovery",
    "check:model-compat": "node --env-file-if-exists=.env.local scripts/check-model-compatibility.mjs",
    "test": "npm run typecheck && npm run build && node --experimental-strip-types --test tests/*.test.mjs && npm run test:unit",
    "test:public": "npm run typecheck && npm run build && node scripts/test-public.mjs",
    "test:agent": "npm run sdk:build && node scripts/test-agent-lab.mjs",
    "test:page-agent:e2e": "node scripts/test-page-agent-e2e.mjs",
    "benchmark": "node scripts/benchmark/run.mjs",
    "benchmark:up": "node scripts/benchmark/up.mjs",
    "benchmark:down": "node scripts/benchmark/down.mjs",
    "benchmark:mirror": "node scripts/benchmark/mirror.mjs",
    "test:agent:debug": "SITEWAKE_AGENT_LAB_HEADED=1 SITEWAKE_AGENT_LAB_TRACE=1 npm run test:agent",
    "test:agent:benchmark": "SITEWAKE_AGENT_LAB_BENCHMARK=1 npm run test:agent",
    "test:knowledge": "node --test --test-name-pattern='^knowledge-' tests/evolution-lab/evolution.test.mjs",
    "test:capability": "node --test --test-name-pattern='^capability-' tests/evolution-lab/evolution.test.mjs",
    "test:capability-v2:fixtures": "node --env-file-if-exists=.env.local scripts/capability-center-v2-fixture-e2e.mjs --all",
    "test:capability-v2:fixtures:validate": "node scripts/capability-center-v2-fixture-e2e.mjs --validate",
    "test:capability-v2:fixtures:reset": "node scripts/capability-center-v2-fixture-reset.mjs",
    "capability:mock": "node node_modules/tsx/dist/cli.mjs scripts/capability-center-v2-notebook-mock.mjs",
    "capability:b:mock": "node node_modules/tsx/dist/cli.mjs scripts/capability-center-v2-notebook-mock.mjs classify",
    "capability:c1:mock": "node node_modules/tsx/dist/cli.mjs scripts/capability-center-v2-c1-mock.mjs",
    "capability:c1:real": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/capability-center-v2-c1-real.mjs",
    "capability:c2:mock": "node node_modules/tsx/dist/cli.mjs scripts/capability-center-v2-notebook-mock.mjs generate-cases",
    "capability:c2:real": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/capability-center-v2-c2-real.mjs",
    "capability:c3:mock": "node node_modules/tsx/dist/cli.mjs scripts/capability-center-v2-notebook-mock.mjs validate",
    "capability:review:mock": "node node_modules/tsx/dist/cli.mjs scripts/capability-center-v2-notebook-mock.mjs review",
    "capability:d:mock": "node node_modules/tsx/dist/cli.mjs scripts/capability-center-v2-notebook-mock.mjs publish",
    "capability:classify": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/capability-center-v2-classify-real.ts",
    "test:capability-classify": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/capability-center-v2-classify-cases.ts",
    "test:capability-mock": "node --import tsx --test tests/capability-center-v2-notebook-mock.test.mjs",
    "test:capability-c1:mock": "node --import tsx --test tests/capability-center-v2-c1-mock.test.mjs",
    "test:capability-c2": "node --import tsx --test tests/capability-center-v2-c2.test.mjs",
    "test:capability-c2:mock": "node --import tsx --test tests/capability-center-v2-c2-mock.test.mjs",
    "test:capability-v2:backend-flow:mock": "node --import tsx tests/capability-center-v2-backend-production-flow.mjs",
    "test:capability-module-harness:production-flow": "node --import tsx tests/capability-center-v2-backend-production-flow.mjs",
    "test:capability-progressive:mock": "node --import tsx --test tests/capability-center-v2-c1-mock.test.mjs tests/capability-center-v2-c2.test.mjs tests/capability-center-v2-c2-mock.test.mjs tests/capability-center-v2-progressive-modules.test.mjs",
    "test:capability-v2:stage-io": "node --import tsx --test tests/capability-center-v2-stage-io.test.mjs",
    "test:capability-v2:module-io": "node --import tsx tests/capability-center-v2-module-io-harness.mjs --all",
    "test:capability-module-harness": "node --import tsx tests/capability-center-v2-module-io-harness.mjs --all",
    "test:capability-v2:module-io:B": "node --import tsx tests/capability-center-v2-module-io-harness.mjs --module B",
    "test:capability-module-harness:B": "node --import tsx tests/capability-center-v2-module-io-harness.mjs --module B",
    "test:capability-v2:module-io:C1": "node --import tsx tests/capability-center-v2-module-io-harness.mjs --module C1",
    "test:capability-module-harness:C1": "node --import tsx tests/capability-center-v2-module-io-harness.mjs --module C1",
    "test:capability-v2:module-io:C2": "node --import tsx tests/capability-center-v2-module-io-harness.mjs --module C2",
    "test:capability-module-harness:C2": "node --import tsx tests/capability-center-v2-module-io-harness.mjs --module C2",
    "test:capability-v2:module-io:C3": "node --import tsx tests/capability-center-v2-module-io-harness.mjs --module C3",
    "test:capability-module-harness:C3": "node --import tsx tests/capability-center-v2-module-io-harness.mjs --module C3",
    "test:capability-v2:module-io:Review": "node --import tsx tests/capability-center-v2-module-io-harness.mjs --module Review",
    "test:capability-module-harness:Review": "node --import tsx tests/capability-center-v2-module-io-harness.mjs --module Review",
    "test:capability-v2:module-io:D": "node --import tsx tests/capability-center-v2-module-io-harness.mjs --module D",
    "test:capability-module-harness:D": "node --import tsx tests/capability-center-v2-module-io-harness.mjs --module D",
    "test:capability-v2:real-site": "npm run test:capability-v2:real-site:runner && npm run test:capability-c2:real-site && npm run test:capability-v2:real-site:production",
    "page-agent:run": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/page-agent-run.ts",
    "test:unit": "node --import tsx --test \"tests/unit/**/*.test.mjs\"",
    "test:evolution": "npm run sdk:build && node scripts/test-evolution-lab.mjs",
    "test:evolution:debug": "SITEWAKE_AGENT_LAB_HEADED=1 SITEWAKE_AGENT_LAB_TRACE=1 npm run test:evolution",
    "test:evolution:benchmark": "SITEWAKE_AGENT_LAB_BENCHMARK=1 npm run test:evolution",
    "eval:evolution:model": "node scripts/eval-evolution-model.mjs",
    "lint": "eslint .",
    "deploy:prepare": "npm run build && node --env-file-if-exists=.env.local --env-file-if-exists=.env.deploy.local scripts/prepare-cloudflare-deploy.mjs",
    "deploy:cloudflare": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.deploy.local scripts/deploy-cloudflare.mjs",
    "deploy:secrets": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.deploy.local scripts/sync-cloudflare-secrets.mjs",
    "runner": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.deploy.local node_modules/tsx/dist/cli.mjs runner/browser-runner.ts",
    "runner:once": "npm run runner -- --once",
    "runner:local": "SITEWAKE_CONTROL_PLANE_URL=http://localhost:3000 npm run runner",
    "container:config": "docker compose -f compose.yaml -f compose.compact.yaml config --quiet",
    "container:up": "docker compose -f compose.yaml -f compose.compact.yaml up -d --build",
    "container:smoke": "node scripts/container-smoke.mjs",
    "server:tunnel": "node --env-file=.env.deploy.local scripts/provision-container-tunnel.mjs",
    "server:deploy": "node --env-file=.env.server.local scripts/deploy-container-server.mjs",
    "server:configure": "node --env-file=.env.server.configure.local scripts/configure-container-server.mjs",
    "release:validation": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.deploy.local --env-file-if-exists=.env.tunnel.local --env-file-if-exists=.env.server.local scripts/release-validation.mjs",
    "server:activate": "node --env-file=.env.deploy.local --env-file-if-exists=.env.tunnel.local scripts/activate-container-runtime.mjs",
    "server:migrate": "node scripts/migrate-d1-postgres.mjs",
    "test:capability-recovery": "node --import tsx --test tests/capability-center-v2-recovery.test.mjs tests/capability-experience-intake.test.mjs tests/unit/capability-center/production-status.test.mjs tests/capability-exploration-convergence.test.mjs tests/capability-v2-failure-diagnostics.test.mjs && npm run test:capability-workspace",
    "capability:workspace": "node --import tsx scripts/capability-workspace.mjs",
    "test:capability-workspace": "node --import tsx --test tests/capability-workspace.test.mjs tests/capability-workspace-checkpoint.test.mjs tests/capability-v2-javascript-author.test.mjs tests/capability-v2-experience-replay.test.mjs tests/capability-exploration-convergence.test.mjs tests/capability-center-v2-c2-mock.test.mjs",
    "test:capability-runtime": "node --import tsx --test tests/capability-sdk-execution.test.mjs tests/agent-tool-choice.test.mjs tests/capability-cors.test.mjs tests/capability-center-v2-stage-io.test.mjs tests/capability-center-v2-control-flow.test.mjs tests/compiled-runtime-deadline.test.mjs tests/agent-run-v3.test.mjs tests/agent-operation-trace.test.mjs tests/runtime-request-timing.test.mjs tests/agent-startup.test.mjs tests/capability-business-result.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@page-agent/core": "1.12.1",
    "@page-agent/llms": "1.12.1",
    "@page-agent/page-controller": "1.12.1",
    "@types/pg": "^8.20.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "elkjs": "^0.11.1",
    "ipaddr.js": "^2.4.0",
    "next": "^16.3.6",
    "pg": "^8.22.0",
    "playwright": "^1.55.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "safe-regex2": "^5.0.0",
    "tsx": "^4.20.6",
    "vinext": "0.0.45",
    "vite": "8.2.1",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "browserslist": "4.28.8",
    "fast-uri": "3.1.8",
    "hono": "4.13.8",
    "ip-address": "10.7.3",
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "qs": "6.16.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.1",
    "@openai/codex": "^0.145.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "^0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.2.12",
    "likec4": "1.59.2",
    "miniflare": "4.20260515.0",
    "tailwindcss": "4.2.1",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "5.9.3",
    "wrangler": "4.123.0"
  },
  "type": "module"
}
