# Server-only model credential for any OpenAI-compatible provider. The browser
# calls the model proxy and never receives this value. Optional here: the
# console's onboarding (step 3) and Settings page configure the model and
# keep it in the local database; values here act as the starting point.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL=gpt-5.6-luna

# Optional: use a different model for one role. Unset roles use MODEL above.
#   MODEL_EXECUTION — real-time page tasks and capability authoring
#   MODEL_SEMANTIC  — background site understanding and experience aggregation
MODEL_EXECUTION=
MODEL_SEMANTIC=

# Read-only compatibility: OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL are
# still accepted because many machines already export them. New setups should
# use the MODEL_* names above.

# Runner Control defaults. `npm run dev` creates an in-memory enrollment token
# for its paired local Runner; shared/container deployments must configure a
# strong token explicitly and pass the same value to both processes.
SITEWAKE_RUNNER_ENROLLMENT_TOKEN=
SITEWAKE_RUNNER_VISIBILITY=full
SITEWAKE_RUNNER_LEASE_AUTHORITY=central
SITEWAKE_LEGACY_RUNNER_PROTOCOL=false

# Optional server-to-server crawl exception. The token must be at least 32
# bytes and must also exist in the target site's server-only secret store.
# It is sent only to the exact HTTPS origins listed here.
SITEWAKE_CRAWL_AUTH_ORIGINS=
SITEWAKE_CRAWL_SHARED_TOKEN=

# Public runtime model cost guard. Defaults are suitable for initial dogfood.
SITEWAKE_MODEL_MAX_REQUESTS_PER_RUN_MINUTE=100
SITEWAKE_MODEL_MAX_REQUESTS_PER_SITE_DAY=10000
SITEWAKE_MODEL_MAX_CONCURRENT_PER_RUN=1
SITEWAKE_MODEL_MAX_CONCURRENT_PER_SITE=1
# Minimum delay between real runtime model calls for the same site/run.
SITEWAKE_MODEL_MIN_INTERVAL_MS=1500

# Independent PageAgent/capability rollout controls. Evidence V2 is active
# only when Runtime V2 is enabled for the same site.
# Values: off, on, sites:site-a,site-b, or percent:10.
SITEWAKE_PAGE_AGENT_RUNTIME_V2=off
SITEWAKE_PAGE_AGENT_EVIDENCE_V2=off
SITEWAKE_CAPABILITY_EXPERIENCE_OUTBOX=off

# Cloudflare deployment configuration used by scripts/prepare-cloudflare-deploy.mjs.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_WORKER_NAME=your-worker-name
CLOUDFLARE_ZONE_NAME=example.com
CLOUDFLARE_ROUTE_HOSTNAME=agent.example.com
CLOUDFLARE_D1_DATABASE_NAME=sitewake-demo-db
CLOUDFLARE_D1_DATABASE_ID=

# Site access password (访问密码) management. Optional master key that authorizes
# managing and recovering the access password from the /access panel. When unset,
# the current access password authorizes changes and the first setup is open
# (the site is already public until a password is set). The session-signing secret
# is generated and stored server-side, so it needs no environment variable.
ACCESS_ADMIN_KEY=
