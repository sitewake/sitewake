{
  "schemaVersion": "capability-module-harness-case.v1",
  "module": "Review",
  "caseId": "REVIEW-07",
  "title": "站点附加审核规则参与 Review 但不改变协议",
  "baseRef": "../../bases/review-input.json",
  "setup": {
    "siteReviewRule": "搜索能力必须证明无业务写入",
    "modelScenario": "reject-missing-site-rule-evidence"
  },
  "expected": {
    "outcome": "success",
    "assertions": [
      { "path": "outcome", "op": "equals", "value": "Rejected" },
      { "path": "authorization", "op": "absent" }
    ],
    "sideEffects": [
      { "path": "reviewPromptContainsSiteRule", "op": "equals", "value": true },
      { "path": "publishCount", "op": "equals", "value": 0 }
    ]
  }
}

