{
  "schemaVersion": "capability-module-harness-case.v1",
  "module": "Review",
  "caseId": "REVIEW-03",
  "title": "模型调用失败时返回 Error 并保留候选",
  "baseRef": "../../bases/review-input.json",
  "setup": { "fault": "review-model-timeout" },
  "expected": {
    "outcome": "success",
    "assertions": [
      { "path": "outcome", "op": "equals", "value": "Error" },
      { "path": "reason", "op": "present" },
      { "path": "authorization", "op": "absent" }
    ],
    "sideEffects": [
      { "path": "publishCount", "op": "equals", "value": 0 },
      { "path": "artifactDeleted", "op": "equals", "value": false }
    ]
  }
}

