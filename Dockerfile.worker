FROM mcr.microsoft.com/playwright:v1.61.1-noble
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
COPY scripts/npm-ci-retry.sh scripts/npm-ci-retry.sh
# Keep dependency and browser installation in separate cacheable layers. A
# browser download failure must not discard a successful npm install, and vice
# versa, because this image is also built on compact production hosts.
RUN sh scripts/npm-ci-retry.sh \
 && npm prune --omit=dev \
 && npm cache clean --force
ARG CODEX_CLI_VERSION=0.69.0
RUN npm install -g "@openai/codex@${CODEX_CLI_VERSION}" \
 && vendor_root="$(npm root -g)/@openai/codex/vendor" \
 && case "$(uname -m)" in x86_64) keep=x86_64-unknown-linux-musl ;; aarch64) keep=aarch64-unknown-linux-musl ;; *) exit 1 ;; esac \
 && find "$vendor_root" -mindepth 1 -maxdepth 1 -type d ! -name "$keep" -exec rm -rf -- {} + \
 && codex --version
COPY . .
ENV NODE_ENV=production SITEWAKE_RUNNER_PREWARM=0 SITEWAKE_RUNNER_CONCURRENCY=1
CMD ["npm", "run", "runner"]
